#!/usr/bin/env bash
# chsig-prioritize — the "prioritize" stage of signals -> prioritize -> interrogate.
#
# Pipes chsig's factual signals to `claude -p` so it names the 3-5 symbols to read first,
# with signal-grounded reasons. Deliberately a thin shell layer, not Rust: the LLM call is
# non-deterministic I/O, so it stays outside the deterministic chsig core and no judgment
# leaks back into it.
#
# Usage: chsig-prioritize [git diff args]   e.g. chsig-prioritize main...HEAD
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Use the most recently built of the local builds and the one on PATH, so a stale
# target/debug never shadows a newer install (or vice versa).
chsig=""
for cand in "$here/target/release/chsig" "$here/target/debug/chsig" "$(command -v chsig || true)"; do
  [ -n "$cand" ] && [ -x "$cand" ] || continue
  if [ -z "$chsig" ] || [ "$cand" -nt "$chsig" ]; then chsig="$cand"; fi
done
[ -n "$chsig" ] || { echo "chsig-prioritize: chsig binary not found (build it first)" >&2; exit 1; }
command -v claude >/dev/null 2>&1 || { echo "chsig-prioritize: claude CLI not found" >&2; exit 1; }

# chsig runs in the caller's repo (its own cwd), not this script's dir.
signals="$("$chsig" "$@")"
if [ -z "${signals//[[:space:]]/}" ]; then
  echo "chsig-prioritize: no signals (empty diff, no change inside a recognized symbol, or every file skipped as noted above)" >&2
  exit 0
fi

prompt=$(cat <<'PROMPT'
You are given `change-signals` output: per changed symbol, coarse factual signals from a
git diff. You see only these signals — not the code or the diff.
Signal meanings (all facts, deliberately crude):
- refs=N   : lines across the repo matching the symbol name (git grep -w). NOT resolved
             references — strings/comments count, and short/common names (index, query, e)
             inflate. A high number alone is weak evidence.
- branch±N : net change in branch points on the changed lines (if, final else, case, default or
             match arm, ternary, &&, ||, ??, let-else), read from the syntax tree.
- calls: ... : names called on the changed lines, as written (receiver.method, or the root of a
             call chain; `*` is a receiver with no name to show, as in `(a + b).abs()` or
             a literal). +name only on added lines, -name only on removed lines, bare name
             on both.
             No meaning is attached: judge from the names yourself which calls cross a
             boundary such as persistence, network, filesystem or process, and which are
             plain in-memory work.
- new|deleted : the symbol name is defined only after / only before the change. Matched
                by name, so a rename appears as one deleted and one new symbol.

Task: choose the 3-5 symbols that appear most useful to READ FIRST when investigating
this change.
- Use the signals as evidence, not as a scoring formula. Consider which symbols are most
  likely to explain the shape and consequences of the change. Multiple signals may
  strengthen a case, but no individual signal implies risk. Discount refs when the name
  is short or generic.
- For each pick: `symbol` — one line citing the specific signals that justify it.
- Do NOT claim the rest are "safe to skip": you are choosing a reading order, not issuing
  a verdict. Unlisted symbols are simply lower priority, not cleared.
- End with one line naming which pick to run `interrogate` on first.
Output only the list and that final line. No preamble.
PROMPT
)

printf '%s' "$signals" | claude -p "$prompt"
